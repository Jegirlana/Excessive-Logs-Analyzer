# ===================================
# API Keys - Configure pelo menos uma
# ===================================

# ============ APIs GRATUITAS (RECOMENDADO) ============

# Groq API Key (GRATUITO - 30 RPM, 14.400 RPD)
# Obtenha em: https://console.groq.com/
GROQ_API_KEY=sua_chave_groq_aqui

# Google Gemini API Key (GRATUITO - 15 RPM, 1M tokens/mês)
# Obtenha em: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=sua_chave_google_aqui

# OpenRouter API Key (GRATUITO - acesso ao Claude 3.5 Haiku e outros)
# Obtenha em: https://openrouter.ai/  →  crie conta → "Keys" → "Create Key"
# Provê Claude via interface OpenAI-compatível, sem necessidade de API paga
OPENROUTER_API_KEY=sua_chave_openrouter_aqui

# GitHub Token (GRATUITO - acesso ao GPT-4o Mini via GitHub Models)
# Obtenha em: https://github.com/settings/tokens  →  "Generate new token (classic)"
# Permissões mínimas necessárias: nenhuma (token de acesso público é suficiente)
GITHUB_TOKEN=seu_github_token_aqui

# ============ APIs PAGAS (OPCIONAL) ============

# Claude/Anthropic API Key (PAGO - OPCIONAL)
# Se configurado, tem prioridade sobre OPENROUTER_API_KEY
# ANTHROPIC_API_KEY=sua_chave_anthropic_aqui

# OpenAI API Key (PAGO - OPCIONAL)
# Se configurado, tem prioridade sobre GITHUB_TOKEN
# OPENAI_API_KEY=sua_chave_openai_aqui

# ===================================
# Model Configuration
# ===================================

# Groq model (default: llama3-70b-8192)
# Opções: llama3-70b-8192, llama-3.1-8b-instant, llama3-8b-8192
GROQ_MODEL_NAME=llama3-70b-8192

# Google Gemini model (default: gemini-flash-latest)
# Opções: gemini-flash-latest (rápido), gemini-2.5-flash, gemini-2.5-pro (avançado)
GEMINI_MODEL_NAME=gemini-flash-latest

# Claude model via OpenRouter (default: anthropic/claude-3.5-haiku)
# Opções: anthropic/claude-3.5-haiku, anthropic/claude-3.5-sonnet (pode gerar custo)
CLAUDE_MODEL_NAME=anthropic/claude-3.5-haiku

# OpenAI model via GitHub Models (default: gpt-4o-mini)
# Opções: gpt-4o-mini (gratuito), gpt-4o (via OPENAI_API_KEY pago)
OPENAI_MODEL_NAME=gpt-4o-mini

# ===================================
# Analysis Configuration
# ===================================

MAX_LOGS_PER_ANALYSIS=1000
SAMPLING_THRESHOLD=100
